<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#050706"
    android:padding="10dp">

    <LinearLayout
        android:id="@+id/runReadyScreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="6dp"
        android:paddingEnd="6dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.14"
            android:text="TOMATO FARM"
            android:textColor="#D7FF3F"
            android:textSize="9sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/runReadyGpsStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="바로 시작할 수 있어요"
            android:textColor="#81877D"
            android:textSize="9sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/runStartButton"
                    android:layout_width="@dimen/strength_mode_button_size"
                    android:layout_height="@dimen/strength_mode_button_size"
                    android:background="@drawable/wear_cardio_circle_primary"
                    android:contentDescription="러닝 시작"
                    android:gravity="center"
                    android:text="🏃"
                    android:textColor="#06120C"
                    android:textSize="@dimen/strength_text_mode_icon" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="러닝"
                    android:textColor="#F7F8F4"
                    android:textSize="@dimen/strength_text_mode_label"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/strengthOpenButton"
                    android:layout_width="@dimen/strength_mode_button_size"
                    android:layout_height="@dimen/strength_mode_button_size"
                    android:background="@drawable/wear_cardio_circle_muted"
                    android:contentDescription="헬스 시작"
                    android:gravity="center"
                    android:text="🏋"
                    android:textColor="#F7F8F4"
                    android:textSize="@dimen/strength_text_mode_icon" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="헬스"
                    android:textColor="#F7F8F4"
                    android:textSize="@dimen/strength_text_mode_label"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/wearModeGuardStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text=""
            android:textColor="#FF9B6B"
            android:textSize="9sp" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/runActiveScreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="0dp"
        android:paddingEnd="0dp"
        android:visibility="gone">

        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/runMetricPager"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:overScrollMode="never" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/runActiveElapsed"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:text="00:00" />

            <TextView
                android:id="@+id/runActiveDistance"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:text="0.00 킬로미터" />

            <TextView
                android:id="@+id/runActivePace"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:text="-- 페이스" />

            <TextView
                android:id="@+id/runActiveHeartRate"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:text="-- bpm 심박수" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_gravity="bottom"
            android:background="@drawable/wear_run_footer_scrim"
            android:elevation="8dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:gravity="center_vertical|end"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/runMetricPageIndicator"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:gravity="end"
                    android:maxLines="1"
                    android:text="요약  ● ○ ○ ○ ○"
                    android:textColor="#F7F8F4"
                    android:textSize="8sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/runActiveGpsStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:gravity="end"
                    android:maxLines="1"
                    android:text="경로 자동 기록"
                    android:textColor="#81877D"
                    android:textSize="8sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/runPauseButton"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/wear_cardio_circle_muted"
                android:clickable="true"
                android:contentDescription="러닝 기록 일시정지"
                android:focusable="true"
                android:gravity="center"
                android:text="II"
                android:textColor="#F7F8F4"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>
    </FrameLayout>

    <LinearLayout
        android:id="@+id/runPausedScreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.12"
            android:text="RUN PAUSED"
            android:textColor="#D7FF3F"
            android:textSize="9sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/runPausedElapsed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:fontFamily="sans-serif-condensed"
            android:text="00:00"
            android:textColor="#F7F8F4"
            android:textSize="32sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/runFinalStopButton"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/wear_cardio_circle_stop"
                android:gravity="center"
                android:text="종료"
                android:textColor="#F7F8F4"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/runResumeButton"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="@drawable/wear_cardio_circle_primary"
                android:gravity="center"
                android:text="계속"
                android:textColor="#06120C"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/runSummaryScreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingTop="0dp"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/runSummaryDistance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-condensed"
            android:text="0.00 km"
            android:textColor="#F7F8F4"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/runSummaryDuration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="00:00"
            android:textColor="#A5ABA1"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/runSummaryPace"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="--"
                android:textColor="#D7FF3F"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/runSummaryHeartRate"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="-- bpm"
                android:textColor="#FF775F"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/runSummaryGpsStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="경로 없이 저장됨"
            android:textColor="#81877D"
            android:textSize="8sp" />

        <TextView
            android:id="@+id/runSummarySyncStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text=""
            android:textColor="#D7FF3F"
            android:textSize="8sp" />

        <TextView
            android:id="@+id/runSummaryDoneButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginTop="7dp"
            android:background="@drawable/wear_cardio_circle_primary"
            android:gravity="center"
            android:text="완료"
            android:textColor="#06120C"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 헬스(근력) 종목 피커: 최근 -> 부위 그룹 -> 종목 목록, WearStrengthUiController가 단일
         어댑터로 2단 네비게이션을 구현한다 (계획서 Phase 4 참조). -->
    <FrameLayout
        android:id="@+id/strengthPickerScreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <androidx.wear.widget.WearableRecyclerView
            android:id="@+id/strengthPickerList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:paddingStart="@dimen/strength_safe_area_horizontal"
            android:paddingTop="@dimen/strength_safe_area_vertical"
            android:paddingEnd="@dimen/strength_safe_area_horizontal"
            android:paddingBottom="@dimen/strength_safe_area_vertical" />

        <LinearLayout
            android:id="@+id/strengthContextEmptyView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="@dimen/strength_safe_area_horizontal"
            android:paddingEnd="@dimen/strength_safe_area_horizontal"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="휴대폰 앱을 열어 동기화해 주세요"
                android:textColor="#A5ABA1"
                android:textSize="14sp" />
        </LinearLayout>
    </FrameLayout>

    <!-- 헬스(근력) 활성 캐러셀: 상단 아크(페이지 도트 + 라이브 심박), 중앙 종목 카드 캐러셀,
         하단 운동 추가/운동 종료. -->
    <FrameLayout
        android:id="@+id/strengthActiveScreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/strengthExercisePager"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:overScrollMode="never" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingTop="10dp">

            <LinearLayout
                android:id="@+id/strengthPageDots"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal" />

            <TextView
                android:id="@+id/strengthHeartIcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="♥"
                android:textColor="#FF775F"
                android:textSize="@dimen/strength_hr_icon_size" />

            <TextView
                android:id="@+id/strengthLiveHeartRate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="3dp"
                android:text="-- bpm"
                android:textColor="#FF775F"
                android:textSize="@dimen/strength_text_hr" />

            <TextView
                android:id="@+id/strengthRestChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:clickable="true"
                android:focusable="true"
                android:text=""
                android:textColor="#D7FF3F"
                android:textSize="@dimen/strength_text_hr"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/strengthActiveStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:text=""
            android:textColor="#FF9B6B"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="@drawable/wear_run_footer_scrim"
            android:elevation="8dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingTop="8dp"
            android:paddingEnd="10dp"
            android:paddingBottom="8dp">

            <TextView
                android:id="@+id/strengthAddExerciseButton"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/strength_action_button_height"
                android:layout_marginEnd="8dp"
                android:background="@drawable/wear_strength_pill_muted"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="운동 추가"
                android:textColor="#F7F8F4"
                android:textSize="@dimen/strength_text_action_button"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/strengthFinishButton"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/strength_action_button_height"
                android:background="@drawable/wear_strength_pill_stop"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="운동 종료"
                android:textColor="#FF5E66"
                android:textSize="@dimen/strength_text_action_button"
                android:textStyle="bold" />
        </LinearLayout>
    </FrameLayout>

    <!-- 헬스(근력) 요약: 소요 시간 + 종목/세트 + 볼륨 + avg·max 심박 + 동기화 상태. A compact
         stack (rather than one long stats line) so nothing clips against the round safe area at
         realistic values (e.g. "12,480kg"). -->
    <LinearLayout
        android:id="@+id/strengthSummaryScreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="@dimen/strength_safe_area_horizontal"
        android:paddingEnd="@dimen/strength_safe_area_horizontal"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.12"
            android:text="운동 완료"
            android:textColor="#D7FF3F"
            android:textSize="9sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/strengthSummaryDuration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="sans-serif-condensed"
            android:gravity="center"
            android:text="00:00"
            android:textColor="#F7F8F4"
            android:textSize="@dimen/strength_text_summary_duration"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/strengthSummaryCounts"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/strengthSummaryExerciseCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="0종목"
                android:textColor="#F7F8F4"
                android:textSize="@dimen/strength_text_summary_count"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:gravity="center"
                android:text="·"
                android:textColor="#81877D"
                android:textSize="@dimen/strength_text_summary_count" />

            <TextView
                android:id="@+id/strengthSummarySetCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="0세트"
                android:textColor="#F7F8F4"
                android:textSize="@dimen/strength_text_summary_count"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/strengthSummaryVolume"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:fontFamily="sans-serif-condensed"
            android:gravity="center"
            android:text="볼륨 0kg"
            android:textColor="#A5ABA1"
            android:textSize="@dimen/strength_text_summary_volume" />

        <TextView
            android:id="@+id/strengthSummaryHeartRate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text=""
            android:textColor="#FF775F"
            android:textSize="@dimen/strength_text_summary_hr" />

        <TextView
            android:id="@+id/strengthSummarySyncStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text=""
            android:textColor="#D7FF3F"
            android:textSize="@dimen/strength_text_summary_sync" />

        <TextView
            android:id="@+id/strengthSummaryDoneButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/wear_cardio_circle_primary"
            android:gravity="center"
            android:text="완료"
            android:textColor="#06120C"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 헬스(근력) 세트 편집: 체크리스트의 한 세트를 중량/횟수/RIR/ROM 네 값 모두 한 화면에서
         조정하는 전체화면 오버레이. 네 행은 완전히 동일한 구조/크기(라벨-버튼-값-버튼)이며, 로터리
         베젤은 마지막으로 탭한 행(기본값 중량)에 적용된다 — 포커스된 행의 값 글자만 라임으로
         강조한다. 480px(240dp) 원형 화면에 안전영역까지 포함해 정확히 맞도록 각 치수를 계산했다
         (dimens.xml의 strength_edit_* 토큰 주석 참조). -->
    <FrameLayout
        android:id="@+id/strengthEditScreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingStart="@dimen/strength_safe_area_horizontal"
            android:paddingTop="@dimen/strength_safe_area_vertical"
            android:paddingEnd="@dimen/strength_safe_area_horizontal"
            android:paddingBottom="@dimen/strength_safe_area_vertical">

            <TextView
                android:id="@+id/strengthEditSetLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="1세트"
                android:textColor="#81877D"
                android:textSize="@dimen/strength_text_edit_set_label" />

            <LinearLayout
                android:id="@+id/strengthEditKgRow"
                android:layout_width="match_parent"
                android:layout_height="@dimen/strength_edit_row_height"
                android:layout_marginTop="4dp"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="@dimen/strength_edit_label_width"
                    android:layout_height="wrap_content"
                    android:gravity="end|center_vertical"
                    android:paddingEnd="6dp"
                    android:text="중량"
                    android:textColor="#81877D"
                    android:textSize="@dimen/strength_text_edit_row_label" />

                <TextView
                    android:id="@+id/strengthEditKgMinus"
                    android:layout_width="@dimen/strength_edit_button_size"
                    android:layout_height="@dimen/strength_edit_button_size"
                    android:background="@drawable/wear_cardio_circle_muted"
                    android:clickable="true"
                    android:contentDescription="중량 감소"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="−"
                    android:textColor="#F7F8F4"
                    android:textSize="@dimen/strength_edit_button_icon_size"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/strengthEditKgValue"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-condensed"
                    android:gravity="center"
                    android:minWidth="@dimen/strength_edit_value_min_width"
                    android:text="20kg"
                    android:textColor="#D7FF3F"
                    android:textSize="@dimen/strength_text_edit_row_value"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/strengthEditKgPlus"
                    android:layout_width="@dimen/strength_edit_button_size"
                    android:layout_height="@dimen/strength_edit_button_size"
                    android:background="@drawable/wear_cardio_circle_muted"
                    android:clickable="true"
                    android:contentDescription="중량 증가"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="+"
                    android:textColor="#F7F8F4"
                    android:textSize="@dimen/strength_edit_button_icon_size"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/strengthEditRepsRow"
                android:layout_width="match_parent"
                android:layout_height="@dimen/strength_edit_row_height"
                android:layout_marginTop="4dp"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="@dimen/strength_edit_label_width"
                    android:layout_height="wrap_content"
                    android:gravity="end|center_vertical"
                    android:paddingEnd="6dp"
                    android:text="횟수"
                    android:textColor="#81877D"
                    android:textSize="@dimen/strength_text_edit_row_label" />

                <TextView
                    android:id="@+id/strengthEditRepsMinus"
                    android:layout_width="@dimen/strength_edit_button_size"
                    android:layout_height="@dimen/strength_edit_button_size"
                    android:background="@drawable/wear_cardio_circle_muted"
                    android:clickable="true"
                    android:contentDescription="횟수 감소"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="−"
                    android:textColor="#F7F8F4"
                    android:textSize="@dimen/strength_edit_button_icon_size"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/strengthEditRepsValue"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-condensed"
                    android:gravity="center"
                    android:minWidth="@dimen/strength_edit_value_min_width"
                    android:text="10회"
                    android:textColor="#F7F8F4"
                    android:textSize="@dimen/strength_text_edit_row_value"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/strengthEditRepsPlus"
                    android:layout_width="@dimen/strength_edit_button_size"
                    android:layout_height="@dimen/strength_edit_button_size"
                    android:background="@drawable/wear_cardio_circle_muted"
                    android:clickable="true"
                    android:contentDescription="횟수 증가"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="+"
                    android:textColor="#F7F8F4"
                    android:textSize="@dimen/strength_edit_button_icon_size"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/strengthEditRirRow"
                android:layout_width="match_parent"
                android:layout_height="@dimen/strength_edit_row_height"
                android:layout_marginTop="4dp"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="@dimen/strength_edit_label_width"
                    android:layout_height="wrap_content"
                    android:gravity="end|center_vertical"
                    android:paddingEnd="6dp"
                    android:text="RIR"
                    android:textColor="#81877D"
                    android:textSize="@dimen/strength_text_edit_row_label" />

                <TextView
                    android:id="@+id/strengthEditRirMinus"
                    android:layout_width="@dimen/strength_edit_button_size"
                    android:layout_height="@dimen/strength_edit_button_size"
                    android:background="@drawable/wear_cardio_circle_muted"
                    android:clickable="true"
                    android:contentDescription="RIR 감소"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="−"
                    android:textColor="#F7F8F4"
                    android:textSize="@dimen/strength_edit_button_icon_size"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/strengthEditRirValue"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-condensed"
                    android:gravity="center"
                    android:minWidth="@dimen/strength_edit_value_min_width"
                    android:text="–"
                    android:textColor="#F7F8F4"
                    android:textSize="@dimen/strength_text_edit_row_value"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/strengthEditRirPlus"
                    android:layout_width="@dimen/strength_edit_button_size"
                    android:layout_height="@dimen/strength_edit_button_size"
                    android:background="@drawable/wear_cardio_circle_muted"
                    android:clickable="true"
                    android:contentDescription="RIR 증가"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="+"
                    android:textColor="#F7F8F4"
                    android:textSize="@dimen/strength_edit_button_icon_size"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/strengthEditRomRow"
                android:layout_width="match_parent"
                android:layout_height="@dimen/strength_edit_row_height"
                android:layout_marginTop="4dp"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="@dimen/strength_edit_label_width"
                    android:layout_height="wrap_content"
                    android:gravity="end|center_vertical"
                    android:paddingEnd="6dp"
                    android:text="ROM"
                    android:textColor="#81877D"
                    android:textSize="@dimen/strength_text_edit_row_label" />

                <TextView
                    android:id="@+id/strengthEditRomMinus"
                    android:layout_width="@dimen/strength_edit_button_size"
                    android:layout_height="@dimen/strength_edit_button_size"
                    android:background="@drawable/wear_cardio_circle_muted"
                    android:clickable="true"
                    android:contentDescription="가동범위 감소"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="−"
                    android:textColor="#F7F8F4"
                    android:textSize="@dimen/strength_edit_button_icon_size"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/strengthEditRomValue"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-condensed"
                    android:gravity="center"
                    android:minWidth="@dimen/strength_edit_value_min_width"
                    android:text="100%"
                    android:textColor="#F7F8F4"
                    android:textSize="@dimen/strength_text_edit_row_value"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/strengthEditRomPlus"
                    android:layout_width="@dimen/strength_edit_button_size"
                    android:layout_height="@dimen/strength_edit_button_size"
                    android:background="@drawable/wear_cardio_circle_muted"
                    android:clickable="true"
                    android:contentDescription="가동범위 증가"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="+"
                    android:textColor="#F7F8F4"
                    android:textSize="@dimen/strength_edit_button_icon_size"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/strengthEditConfirmButton"
                android:layout_width="match_parent"
                android:layout_height="@dimen/strength_edit_confirm_height"
                android:layout_marginTop="4dp"
                android:background="@drawable/wear_strength_pill_primary"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="확인"
                android:textColor="#06120C"
                android:textSize="@dimen/strength_text_complete_button"
                android:textStyle="bold" />
        </LinearLayout>
    </FrameLayout>

    <!-- 헬스(근력) 휴식 타이머: 세트 완료 직후 자동 표시되는 전체화면 오버레이 (플래그십 상호작용).
         페이저 스와이프나 하단 pill 조작 시 이 화면만 숨겨지고, 타이머 자체는
         WearStrengthSessionState.restEndsAtMs로 계속 진행된다. -->
    <FrameLayout
        android:id="@+id/strengthRestScreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="@dimen/strength_safe_area_horizontal"
            android:paddingEnd="@dimen/strength_safe_area_horizontal">

            <FrameLayout
                android:layout_width="@dimen/strength_rest_ring_size"
                android:layout_height="@dimen/strength_rest_ring_size"
                android:layout_marginBottom="4dp">

                <com.lifestreak.wear.workout.WearStrengthRestRingView
                    android:id="@+id/strengthRestRing"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <TextView
                    android:id="@+id/strengthRestCountdown"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:fontFamily="sans-serif-condensed"
                    android:text="1:30"
                    android:textColor="#F7F8F4"
                    android:textSize="@dimen/strength_text_rest_countdown"
                    android:textStyle="bold" />
            </FrameLayout>

            <TextView
                android:id="@+id/strengthRestNextPreview"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:text=""
                android:textColor="#81877D"
                android:textSize="@dimen/strength_text_last_record" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/strengthRestExtend"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/strength_action_button_height"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/wear_strength_pill_muted"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="+15초"
                    android:textColor="#F7F8F4"
                    android:textSize="@dimen/strength_text_action_button"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/strengthRestSkip"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/strength_action_button_height"
                    android:layout_weight="1"
                    android:background="@drawable/wear_strength_pill_primary"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="건너뛰기"
                    android:textColor="#06120C"
                    android:textSize="@dimen/strength_text_action_button"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
