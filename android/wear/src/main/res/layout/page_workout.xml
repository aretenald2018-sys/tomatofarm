<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#050706"
    android:padding="10dp">

    <LinearLayout
        android:id="@+id/runReadyScreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="6dp"
        android:paddingEnd="6dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.14"
            android:text="TOMATO FARM"
            android:textColor="#D7FF3F"
            android:textSize="9sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/runReadyGpsStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="바로 시작할 수 있어요"
            android:textColor="#81877D"
            android:textSize="9sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/runStartButton"
                    android:layout_width="@dimen/strength_mode_button_size"
                    android:layout_height="@dimen/strength_mode_button_size"
                    android:background="@drawable/wear_cardio_circle_primary"
                    android:contentDescription="러닝 시작"
                    android:gravity="center"
                    android:text="🏃"
                    android:textColor="#06120C"
                    android:textSize="@dimen/strength_text_mode_icon" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="러닝"
                    android:textColor="#F7F8F4"
                    android:textSize="@dimen/strength_text_mode_label"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/strengthOpenButton"
                    android:layout_width="@dimen/strength_mode_button_size"
                    android:layout_height="@dimen/strength_mode_button_size"
                    android:background="@drawable/wear_cardio_circle_muted"
                    android:contentDescription="헬스 시작"
                    android:gravity="center"
                    android:text="🏋"
                    android:textColor="#F7F8F4"
                    android:textSize="@dimen/strength_text_mode_icon" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="헬스"
                    android:textColor="#F7F8F4"
                    android:textSize="@dimen/strength_text_mode_label"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/wearModeGuardStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text=""
            android:textColor="#FF9B6B"
            android:textSize="9sp" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/runActiveScreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="0dp"
        android:paddingEnd="0dp"
        android:visibility="gone">

        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/runMetricPager"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:overScrollMode="never" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/runActiveElapsed"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:text="00:00" />

            <TextView
                android:id="@+id/runActiveDistance"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:text="0.00 킬로미터" />

            <TextView
                android:id="@+id/runActivePace"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:text="-- 페이스" />

            <TextView
                android:id="@+id/runActiveHeartRate"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:text="-- bpm 심박수" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_gravity="bottom"
            android:background="@drawable/wear_run_footer_scrim"
            android:elevation="8dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:gravity="center_vertical|end"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/runMetricPageIndicator"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:gravity="end"
                    android:maxLines="1"
                    android:text="요약  ● ○ ○ ○ ○"
                    android:textColor="#F7F8F4"
                    android:textSize="8sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/runActiveGpsStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:gravity="end"
                    android:maxLines="1"
                    android:text="경로 자동 기록"
                    android:textColor="#81877D"
                    android:textSize="8sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/runPauseButton"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/wear_cardio_circle_muted"
                android:clickable="true"
                android:contentDescription="러닝 기록 일시정지"
                android:focusable="true"
                android:gravity="center"
                android:text="II"
                android:textColor="#F7F8F4"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>
    </FrameLayout>

    <LinearLayout
        android:id="@+id/runPausedScreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.12"
            android:text="RUN PAUSED"
            android:textColor="#D7FF3F"
            android:textSize="9sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/runPausedElapsed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:fontFamily="sans-serif-condensed"
            android:text="00:00"
            android:textColor="#F7F8F4"
            android:textSize="32sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/runFinalStopButton"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/wear_cardio_circle_stop"
                android:gravity="center"
                android:text="종료"
                android:textColor="#F7F8F4"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/runResumeButton"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="@drawable/wear_cardio_circle_primary"
                android:gravity="center"
                android:text="계속"
                android:textColor="#06120C"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/runSummaryScreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingTop="0dp"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/runSummaryDistance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-condensed"
            android:text="0.00 km"
            android:textColor="#F7F8F4"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/runSummaryDuration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="00:00"
            android:textColor="#A5ABA1"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/runSummaryPace"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="--"
                android:textColor="#D7FF3F"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/runSummaryHeartRate"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="-- bpm"
                android:textColor="#FF775F"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/runSummaryGpsStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="경로 없이 저장됨"
            android:textColor="#81877D"
            android:textSize="8sp" />

        <TextView
            android:id="@+id/runSummarySyncStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text=""
            android:textColor="#D7FF3F"
            android:textSize="8sp" />

        <TextView
            android:id="@+id/runSummaryDoneButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginTop="7dp"
            android:background="@drawable/wear_cardio_circle_primary"
            android:gravity="center"
            android:text="완료"
            android:textColor="#06120C"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 헬스(근력) 종목 피커: 최근 -> 부위 그룹 -> 종목 목록, WearStrengthUiController가 단일
         어댑터로 2단 네비게이션을 구현한다 (계획서 Phase 4 참조). -->
    <FrameLayout
        android:id="@+id/strengthPickerScreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <androidx.wear.widget.WearableRecyclerView
            android:id="@+id/strengthPickerList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:paddingStart="@dimen/strength_safe_area_horizontal"
            android:paddingTop="@dimen/strength_safe_area_vertical"
            android:paddingEnd="@dimen/strength_safe_area_horizontal"
            android:paddingBottom="@dimen/strength_safe_area_vertical" />

        <LinearLayout
            android:id="@+id/strengthContextEmptyView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="@dimen/strength_safe_area_horizontal"
            android:paddingEnd="@dimen/strength_safe_area_horizontal"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="휴대폰 앱을 열어 동기화해 주세요"
                android:textColor="#A5ABA1"
                android:textSize="14sp" />
        </LinearLayout>
    </FrameLayout>

    <!-- 헬스(근력) 활성 캐러셀: 상단 아크(페이지 도트 + 라이브 심박), 중앙 종목 카드 캐러셀,
         하단 운동 추가/운동 종료. -->
    <FrameLayout
        android:id="@+id/strengthActiveScreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/strengthExercisePager"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:overScrollMode="never" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingTop="10dp">

            <LinearLayout
                android:id="@+id/strengthPageDots"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal" />

            <TextView
                android:id="@+id/strengthHeartIcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="♥"
                android:textColor="#FF775F"
                android:textSize="@dimen/strength_hr_icon_size" />

            <TextView
                android:id="@+id/strengthLiveHeartRate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="3dp"
                android:text="-- bpm"
                android:textColor="#FF775F"
                android:textSize="@dimen/strength_text_hr" />
        </LinearLayout>

        <TextView
            android:id="@+id/strengthActiveStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:text=""
            android:textColor="#FF9B6B"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="@drawable/wear_run_footer_scrim"
            android:elevation="8dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingTop="8dp"
            android:paddingEnd="10dp"
            android:paddingBottom="8dp">

            <TextView
                android:id="@+id/strengthAddExerciseButton"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/strength_action_button_height"
                android:layout_marginEnd="8dp"
                android:background="@drawable/wear_strength_pill_muted"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="운동 추가"
                android:textColor="#F7F8F4"
                android:textSize="@dimen/strength_text_action_button"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/strengthFinishButton"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/strength_action_button_height"
                android:background="@drawable/wear_strength_pill_stop"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="운동 종료"
                android:textColor="#FF5E66"
                android:textSize="@dimen/strength_text_action_button"
                android:textStyle="bold" />
        </LinearLayout>
    </FrameLayout>

    <!-- 헬스(근력) 요약: 종목/세트/볼륨 + avg·max 심박 + 동기화 상태. -->
    <LinearLayout
        android:id="@+id/strengthSummaryScreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="@dimen/strength_safe_area_horizontal"
        android:paddingEnd="@dimen/strength_safe_area_horizontal"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.12"
            android:text="운동 완료"
            android:textColor="#D7FF3F"
            android:textSize="9sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/strengthSummaryStats"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:gravity="center"
            android:text="0종목 · 0세트 · 0kg"
            android:textColor="#F7F8F4"
            android:textSize="@dimen/strength_text_summary_value"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/strengthSummaryHeartRate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:text="-- / -- bpm"
            android:textColor="#FF775F"
            android:textSize="@dimen/strength_text_summary_label" />

        <TextView
            android:id="@+id/strengthSummarySyncStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text=""
            android:textColor="#D7FF3F"
            android:textSize="@dimen/strength_text_summary_sync" />

        <TextView
            android:id="@+id/strengthSummaryDoneButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/wear_cardio_circle_primary"
            android:gravity="center"
            android:text="완료"
            android:textColor="#06120C"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>
