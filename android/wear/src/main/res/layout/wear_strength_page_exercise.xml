<?xml version="1.0" encoding="utf-8"?>
<!--
  One strength-workout carousel card (see the plan's "44mm 대화면 최적화" + Phase 4 sections).
  Bound by WearStrengthPagerAdapter; ids below are looked up from
  WearStrengthUiController/WearStrengthPagerAdapter — keep them in sync if renamed.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingStart="@dimen/strength_safe_area_horizontal"
    android:paddingTop="@dimen/strength_safe_area_vertical"
    android:paddingEnd="@dimen/strength_safe_area_horizontal"
    android:paddingBottom="@dimen/strength_safe_area_vertical">

    <TextView
        android:id="@+id/strengthCardExerciseName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:maxLines="1"
        android:text="운동명"
        android:textColor="#F7F8F4"
        android:textSize="@dimen/strength_text_exercise_name"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/strengthCardLastRecord"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:text=""
        android:textColor="#81877D"
        android:textSize="@dimen/strength_text_last_record" />

    <TextView
        android:id="@+id/strengthCardSetCounter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:text="0세트"
        android:textColor="#D7FF3F"
        android:textSize="@dimen/strength_text_set_counter"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/strengthCardKgMinus"
            android:layout_width="@dimen/strength_kg_button_size"
            android:layout_height="@dimen/strength_kg_button_size"
            android:background="@drawable/wear_cardio_circle_muted"
            android:clickable="true"
            android:contentDescription="중량 감소"
            android:focusable="true"
            android:gravity="center"
            android:text="−"
            android:textColor="#F7F8F4"
            android:textSize="@dimen/strength_kg_button_icon_size"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/strengthCardKgValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:fontFamily="sans-serif-condensed"
            android:gravity="center"
            android:minWidth="86dp"
            android:text="20kg"
            android:textColor="#F7F8F4"
            android:textSize="@dimen/strength_text_kg_value"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/strengthCardKgPlus"
            android:layout_width="@dimen/strength_kg_button_size"
            android:layout_height="@dimen/strength_kg_button_size"
            android:background="@drawable/wear_cardio_circle_muted"
            android:clickable="true"
            android:contentDescription="중량 증가"
            android:focusable="true"
            android:gravity="center"
            android:text="+"
            android:textColor="#F7F8F4"
            android:textSize="@dimen/strength_kg_button_icon_size"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/strengthCardRepsMinus"
            android:layout_width="@dimen/strength_reps_button_size"
            android:layout_height="@dimen/strength_reps_button_size"
            android:background="@drawable/wear_cardio_circle_muted"
            android:clickable="true"
            android:contentDescription="횟수 감소"
            android:focusable="true"
            android:gravity="center"
            android:text="−"
            android:textColor="#F7F8F4"
            android:textSize="@dimen/strength_reps_button_icon_size"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/strengthCardRepsValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:fontFamily="sans-serif-condensed"
            android:gravity="center"
            android:minWidth="62dp"
            android:text="10회"
            android:textColor="#F7F8F4"
            android:textSize="@dimen/strength_text_reps_value" />

        <TextView
            android:id="@+id/strengthCardRepsPlus"
            android:layout_width="@dimen/strength_reps_button_size"
            android:layout_height="@dimen/strength_reps_button_size"
            android:background="@drawable/wear_cardio_circle_muted"
            android:clickable="true"
            android:contentDescription="횟수 증가"
            android:focusable="true"
            android:gravity="center"
            android:text="+"
            android:textColor="#F7F8F4"
            android:textSize="@dimen/strength_reps_button_icon_size"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/strengthCardRomMinus"
            android:layout_width="@dimen/strength_rom_button_size"
            android:layout_height="@dimen/strength_rom_button_size"
            android:background="@drawable/wear_cardio_circle_muted"
            android:clickable="true"
            android:contentDescription="가동범위 감소"
            android:focusable="true"
            android:gravity="center"
            android:text="−"
            android:textColor="#A5ABA1"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/strengthCardRomValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:gravity="center"
            android:text="ROM 100%"
            android:textColor="#A5ABA1"
            android:textSize="@dimen/strength_text_rom" />

        <TextView
            android:id="@+id/strengthCardRomPlus"
            android:layout_width="@dimen/strength_rom_button_size"
            android:layout_height="@dimen/strength_rom_button_size"
            android:background="@drawable/wear_cardio_circle_muted"
            android:clickable="true"
            android:contentDescription="가동범위 증가"
            android:focusable="true"
            android:gravity="center"
            android:text="+"
            android:textColor="#A5ABA1"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/strengthCardCompleteButton"
        android:layout_width="match_parent"
        android:layout_height="@dimen/strength_complete_button_height"
        android:layout_marginTop="10dp"
        android:background="@drawable/wear_strength_pill_primary"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:text="세트 완료"
        android:textColor="#06120C"
        android:textSize="@dimen/strength_text_complete_button"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/strengthCardLoggedTrail"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:text=""
        android:textColor="#81877D"
        android:textSize="@dimen/strength_text_logged_trail" />
</LinearLayout>
