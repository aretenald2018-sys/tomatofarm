<?xml version="1.0" encoding="utf-8"?>
<!--
  One strength-workout carousel page: a Strong/Hevy-style set checklist for one exercise.
  Bound by WearStrengthPagerAdapter, which rebuilds strengthCardSetList's children on every bind
  from wear_strength_set_row.xml (one per WearStrengthCard.sets entry) plus a trailing
  wear_strength_set_row_add.xml "+ 세트 추가" row. Ids below are looked up from
  WearStrengthPagerAdapter — keep them in sync if renamed.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="@dimen/strength_safe_area_horizontal"
    android:paddingTop="@dimen/strength_card_top_inset"
    android:paddingEnd="@dimen/strength_safe_area_horizontal"
    android:paddingBottom="@dimen/strength_card_bottom_inset">

    <TextView
        android:id="@+id/strengthCardExerciseName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:maxLines="1"
        android:text="운동명"
        android:textColor="#F7F8F4"
        android:textSize="@dimen/strength_text_exercise_name"
        android:textStyle="bold" />

    <!-- Tappable: copies the previous session's whole set list onto this card, mirroring the
         phone's 지난 기록 strip. -->
    <TextView
        android:id="@+id/strengthCardLastRecord"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:autoSizeMaxTextSize="@dimen/strength_text_last_record"
        android:autoSizeMinTextSize="10sp"
        android:autoSizeStepGranularity="1sp"
        android:autoSizeTextType="uniform"
        android:background="@drawable/wear_strength_pill_muted"
        android:clickable="true"
        android:ellipsize="end"
        android:focusable="true"
        android:gravity="center"
        android:maxLines="1"
        android:paddingStart="10dp"
        android:paddingTop="6dp"
        android:paddingEnd="10dp"
        android:paddingBottom="6dp"
        android:text=""
        android:textColor="#A5ABA1" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/strengthCardSetList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>
</LinearLayout>
