<?xml version="1.0" encoding="utf-8"?>
<!--
  One set-checklist row: set number | ("웜업"/"BBB" role + "80kg × 8회") | circular check button.
  Bound by WearStrengthPagerAdapter.CardViewHolder.

  The role badge is stacked *above* the values rather than beside them. On a 44mm watch the row has
  only ~104dp between the index and the check button, and a side-by-side badge ate a third of it —
  enough to autosize "60kg × 5회" down to unreadable. Vertically it costs nothing horizontally, and
  the row already had the height to spare.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/setRowRoot"
    android:layout_width="match_parent"
    android:layout_height="@dimen/strength_set_row_height"
    android:layout_marginTop="6dp"
    android:background="@drawable/wear_strength_pill_muted"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="14dp"
    android:paddingEnd="10dp">

    <TextView
        android:id="@+id/setRowIndex"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="18dp"
        android:text="1"
        android:textColor="#81877D"
        android:textSize="@dimen/strength_text_set_row_index" />

    <!-- Tappable while pending -> opens the edit screen. The whole column is the target, so the
         role badge does not carve a dead zone out of it. -->
    <LinearLayout
        android:id="@+id/setRowValuesGroup"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical">

        <!-- Program role badge (웜업 / BBB / PR …). GONE for a plain working set, so an
             unprescribed card renders exactly as it did before. -->
        <TextView
            android:id="@+id/setRowRole"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text=""
            android:textColor="#A5ABA1"
            android:textSize="@dimen/strength_text_set_row_role"
            android:visibility="gone" />

        <TextView
            android:id="@+id/setRowValues"
            android:layout_width="match_parent"
            android:layout_height="@dimen/strength_set_row_values_height"
            android:autoSizeMaxTextSize="@dimen/strength_text_set_row_values"
            android:autoSizeMinTextSize="12sp"
            android:autoSizeStepGranularity="1sp"
            android:autoSizeTextType="uniform"
            android:fontFamily="sans-serif-condensed"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:text="80kg × 8회"
            android:textColor="#F7F8F4"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/setRowCheck"
        android:layout_width="@dimen/strength_set_row_check_size"
        android:layout_height="@dimen/strength_set_row_check_size"
        android:background="@drawable/wear_cardio_circle_muted"
        android:clickable="true"
        android:contentDescription="세트 완료 체크"
        android:focusable="true"
        android:gravity="center"
        android:text=""
        android:textColor="#F7F8F4"
        android:textSize="16sp"
        android:textStyle="bold" />
</LinearLayout>
