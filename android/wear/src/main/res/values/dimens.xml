<?xml version="1.0" encoding="utf-8"?>
<!--
  Strength (헬스) screen dimension tokens for the 44mm (480x480) round-screen optimization pass,
  reworked for the Strong/Hevy-style set-checklist UI (checklist rows + edit/rest overlays). See
  AGENTS.md-linked plan docs (via Git history) for the exact spec these mirror.
-->
<resources>
    <!-- Circular safe area: keep interactive/critical content off the round-screen corners. -->
    <dimen name="strength_safe_area_horizontal">24dp</dimen>
    <dimen name="strength_safe_area_vertical">20dp</dimen>

    <!-- Ready-screen mode buttons (러닝 / 헬스). -->
    <dimen name="strength_mode_button_size">72dp</dimen>
    <dimen name="strength_text_mode_label">12sp</dimen>
    <dimen name="strength_text_mode_icon">28sp</dimen>

    <!-- Checklist page text (exercise name / last-record label). -->
    <dimen name="strength_text_exercise_name">18sp</dimen>
    <dimen name="strength_text_last_record">14sp</dimen>

    <!-- Checklist set rows (wear_strength_set_row.xml / wear_strength_set_row_add.xml). -->
    <dimen name="strength_set_row_height">52dp</dimen>
    <dimen name="strength_set_row_check_size">40dp</dimen>
    <dimen name="strength_text_set_row_index">15sp</dimen>
    <dimen name="strength_text_set_row_values">20sp</dimen>

    <!-- Bottom action row (운동 추가 / 운동 종료). -->
    <dimen name="strength_action_button_height">40dp</dimen>
    <dimen name="strength_text_action_button">13sp</dimen>

    <!-- Top status arc: page dots + live heart rate + rest chip. -->
    <dimen name="strength_page_dot_size">6dp</dimen>
    <dimen name="strength_page_dot_active_size">8dp</dimen>
    <dimen name="strength_page_dot_gap">4dp</dimen>
    <dimen name="strength_hr_icon_size">14dp</dimen>
    <dimen name="strength_text_hr">14sp</dimen>

    <!-- Picker list rows. -->
    <dimen name="strength_picker_row_height">52dp</dimen>
    <dimen name="strength_picker_icon_size">28dp</dimen>
    <dimen name="strength_text_picker_group">18sp</dimen>
    <dimen name="strength_text_picker_exercise">16sp</dimen>
    <dimen name="strength_text_picker_badge">13sp</dimen>
    <dimen name="strength_text_picker_header">13sp</dimen>

    <!-- Set-edit overlay: four uniform rows (중량/횟수/RIR/ROM) sized to fit the 240dp round
         safe area alongside the header + confirm pill without clipping (see the arithmetic in
         the plan: 20 safe + ~16 header + 4x(4 margin + 30 row) + 4 margin + 40 confirm + 20 safe
         = ~236dp of 240dp). Deliberately its own token family, not reused from the old
         strength_kg_*/strength_reps_*/strength_rom_* single-card tokens (removed below; no
         longer referenced now that the checklist replaced the old per-card editor). -->
    <dimen name="strength_text_edit_set_label">13sp</dimen>
    <dimen name="strength_edit_row_height">30dp</dimen>
    <dimen name="strength_edit_button_size">30dp</dimen>
    <dimen name="strength_edit_button_icon_size">14sp</dimen>
    <dimen name="strength_edit_label_width">44dp</dimen>
    <dimen name="strength_edit_value_min_width">76dp</dimen>
    <dimen name="strength_text_edit_row_label">13sp</dimen>
    <dimen name="strength_text_edit_row_value">20sp</dimen>
    <dimen name="strength_edit_confirm_height">40dp</dimen>
    <dimen name="strength_text_complete_button">15sp</dimen>

    <!-- Rest-timer screen. -->
    <dimen name="strength_rest_ring_size">120dp</dimen>
    <dimen name="strength_text_rest_countdown">44sp</dimen>

    <!-- Summary screen. -->
    <dimen name="strength_text_summary_duration">28sp</dimen>
    <dimen name="strength_text_summary_count">20sp</dimen>
    <dimen name="strength_text_summary_volume">18sp</dimen>
    <dimen name="strength_text_summary_hr">14sp</dimen>
    <dimen name="strength_text_summary_sync">13sp</dimen>

    <!-- Ambient (AOD) overlay shared by the run and strength controllers (plan's W1 ambient
         slice): monochrome text only, no drawables — low-bit-ambient safe. -->
    <dimen name="ambient_text_clock">14sp</dimen>
    <dimen name="ambient_text_label">11sp</dimen>
    <dimen name="ambient_text_primary">34sp</dimen>
    <dimen name="ambient_text_secondary">14sp</dimen>
    <dimen name="ambient_text_tertiary">12sp</dimen>
</resources>
